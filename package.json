{
  "name": "penpot-plugin-converter-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Converter Studio for Penpot: place HEIC, camera RAW, AVIF, TIFF, EPS, AI and PDF files on a board, and export a selection as AVIF, WebP, JPG, TIFF, ICO or a smaller PDF.",
  "license": "MIT",
  "author": "Converter Studio <support@converter.studio> (https://converter.studio)",
  "homepage": "https://converter.studio/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tariksucu/penpot-plugin-converter-studio.git"
  },
  "bugs": {
    "url": "https://github.com/tariksucu/penpot-plugin-converter-studio/issues",
    "email": "support@converter.studio"
  },
  "keywords": [
    "penpot",
    "penpot-plugin",
    "converter-studio",
    "heic",
    "raw",
    "avif",
    "tiff",
    "eps",
    "webp",
    "ico"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node build.mjs",
    "serve": "node build.mjs --serve",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.plugin.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@penpot/plugin-types": "1.6.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
